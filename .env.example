# Copy this file to .env in the directory where you run RallyBot.
# Process environment variables override these values.

# Application display name.
APP_NAME=RallyBot
# Allowed values: development, testing, production.
APP_ENV=development
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Database and Ollama settings are used only by explicit infrastructure commands.
DATABASE_URL=sqlite:///./data/rallybot.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Positive timeout in seconds for HTTP connect/read/write/pool operations.
OLLAMA_TIMEOUT_SECONDS=5.0
# LLM generation HTTP timeout, separate from connectivity checks (0 < value <= 300).
OLLAMA_GENERATION_TIMEOUT_SECONDS=60.0

# Optional. Leave unset until needed; never commit a real token.
# DISCORD_BOT_TOKEN=replace-with-your-token
# Required for discord-start: positive development server ID (no global sync).
# DISCORD_GUILD_ID=123456789012345678
